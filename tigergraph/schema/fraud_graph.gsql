// ============================================================================
// TigerGraph GSQL Schema Definition for HHGOA IEEE-CIS Fraud Investigation
// Graph Name: FraudInvestigationGraph
// Aligned with IEEE-CIS Dataset Schema & Case Management Write-Back
// ============================================================================

CREATE GRAPH FraudInvestigationGraph()

USE GRAPH FraudInvestigationGraph

// ----------------------------------------------------------------------------
// Vertices
// ----------------------------------------------------------------------------
CREATE VERTEX Customer(
    PRIMARY_ID id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX Card(
    PRIMARY_ID id STRING,
    customer_id STRING,
    card1 STRING,
    card4 STRING,
    card6 STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX Transaction(
    PRIMARY_ID id STRING,
    ts STRING,
    timestamp UINT,
    amount DOUBLE,
    product_code STRING,
    channel STRING,
    risk_score DOUBLE,
    addr1 STRING,
    addr2 STRING,
    dist1 DOUBLE,
    dist2 DOUBLE,
    p_emaildomain STRING,
    r_emaildomain STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX DeviceProfile(
    PRIMARY_ID id STRING,
    device_info STRING,
    os STRING,
    browser STRING,
    screen STRING,
    device_type STRING,
    is_new STRING,
    proxy STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX EmailDomain(
    PRIMARY_ID id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX BillingRegion(
    PRIMARY_ID id STRING,
    country_code STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX ClosedCase(
    PRIMARY_ID id STRING,
    opened_at STRING,
    closed_at STRING,
    outcome STRING,
    pattern STRING,
    exposure_usd DOUBLE,
    n_txns INT,
    actions_taken STRING,
    report_filed STRING,
    analyst_notes STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

// Dynamic Case Write-Back & Governance Vertices
CREATE VERTEX Case(
    PRIMARY_ID id STRING,
    opened_at STRING,
    trigger_type STRING,
    trigger_text STRING,
    verdict STRING,
    status STRING,
    fraud_probability DOUBLE,
    pattern STRING,
    pattern_description STRING,
    exposure_usd DOUBLE,
    summary STRING,
    written_to_graph BOOL
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX Finding(
    PRIMARY_ID id STRING,
    claim STRING,
    source STRING,
    ref STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX Action(
    PRIMARY_ID id STRING,
    action STRING,
    route STRING,
    reason STRING,
    executed BOOL,
    timestamp STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX FraudPattern(
    PRIMARY_ID id STRING,
    name STRING,
    description STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

// ----------------------------------------------------------------------------
// Edges
// ----------------------------------------------------------------------------
CREATE DIRECTED EDGE OWNS(FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY"
CREATE DIRECTED EDGE MADE(FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_BY"
CREATE DIRECTED EDGE FROM_DEVICE(FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_USED_IN"
CREATE DIRECTED EDGE PURCHASER_EMAIL(FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="PURCHASER_OF"
CREATE DIRECTED EDGE BILLED_IN(FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="TRANSACTIONS_IN"
CREATE DIRECTED EDGE NEXT(FROM Transaction, TO Transaction) WITH REVERSE_EDGE="PREV"

CREATE DIRECTED EDGE INVOLVES(FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="INVOLVED_IN_CLOSED_CASE"
CREATE DIRECTED EDGE ON_CARD(FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CLOSED_CASE_ON_CARD"
CREATE DIRECTED EDGE CONNECTED_TO(FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CONNECTED_CLOSED_CASE"

CREATE DIRECTED EDGE CASE_INVOLVES_TXN(FROM Case, TO Transaction) WITH REVERSE_EDGE="TXN_IN_CASE"
CREATE DIRECTED EDGE CASE_INVOLVES_CARD(FROM Case, TO Card) WITH REVERSE_EDGE="CARD_IN_CASE"
CREATE DIRECTED EDGE CASE_HAS_FINDING(FROM Case, TO Finding) WITH REVERSE_EDGE="FINDING_OF_CASE"
CREATE DIRECTED EDGE CASE_HAS_ACTION(FROM Case, TO Action) WITH REVERSE_EDGE="ACTION_OF_CASE"
CREATE DIRECTED EDGE CASE_IDENTIFIED_PATTERN(FROM Case, TO FraudPattern) WITH REVERSE_EDGE="PATTERN_IN_CASE"
