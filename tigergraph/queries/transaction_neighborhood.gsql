// ============================================================================
// Query: transaction_neighborhood
// Description: Retrieves the 2-hop entity neighborhood around a transaction,
// including customer, card, device, IP, address, merchant, and co-occurring cases.
// ============================================================================

CREATE OR REPLACE QUERY transaction_neighborhood(VERTEX<Transaction> target_txn, INT depth = 2) FOR GRAPH FraudInvestigationGraph {
    ListAccum<EDGE> @@edges;
    SetAccum<VERTEX> @@vertices;

    Start = { target_txn };
    @@vertices += target_txn;

    // Hop 1: Direct connections (Card, Device, IP, Merchant, Address, Email, Account)
    Hop1 = SELECT tgt FROM Start:s -(:e)-> :tgt
           ACCUM @@edges += e, @@vertices += tgt;

    // Reverse hop to account/customer
    Hop1_Rev = SELECT src FROM Start:s -(<PERFORMS_TRANSACTION:e)- Account:src
               ACCUM @@edges += e, @@vertices += src;

    // Hop 2: From Account to Customer, and from Device/IP to other Transactions
    Hop2 = SELECT tgt FROM Hop1:h -(:e)-> :tgt
           WHERE tgt != target_txn
           ACCUM @@edges += e, @@vertices += tgt;

    Hop2_Rev = SELECT src FROM Hop1:h -(<USES_DEVICE|<ORIGINATES_FROM_IP:e)- Transaction:src
               WHERE src != target_txn
               LIMIT 50
               ACCUM @@edges += e, @@vertices += src;

    PRINT @@vertices, @@edges;
}
