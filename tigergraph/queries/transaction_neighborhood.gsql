// ============================================================================
// Query: transaction_neighborhood
// Graph: FraudInvestigationGraph
// Description: Retrieves 2-hop entity neighborhood around an IEEE-CIS transaction,
// connecting Card, Customer, DeviceProfile, BillingRegion, and EmailDomain.
// ============================================================================

CREATE OR REPLACE QUERY transaction_neighborhood(VERTEX<Transaction> target_txn) FOR GRAPH FraudInvestigationGraph {
    ListAccum<EDGE> @@edges;
    SetAccum<VERTEX> @@vertices;

    Start = { target_txn };
    @@vertices += target_txn;

    // Hop 1: Direct links (Card, DeviceProfile, BillingRegion, EmailDomain)
    Hop1_Card = SELECT c FROM Start:s -(MADE_BY:e)- Card:c
                ACCUM @@edges += e, @@vertices += c;

    Hop1_Dev = SELECT d FROM Start:s -(FROM_DEVICE:e)- DeviceProfile:d
               ACCUM @@edges += e, @@vertices += d;

    Hop1_Region = SELECT r FROM Start:s -(BILLED_IN:e)- BillingRegion:r
                  ACCUM @@edges += e, @@vertices += r;

    // Hop 2: Card -> Customer (OWNS)
    Hop2_Cust = SELECT cust FROM Hop1_Card:c -(OWNED_BY:e)- Customer:cust
                ACCUM @@edges += e, @@vertices += cust;

    // Hop 2: Device -> other Transactions sharing device (online fraud ring)
    Hop2_OtherTxns = SELECT t FROM Hop1_Dev:d -(DEVICE_USED_IN:e)- Transaction:t
                     WHERE t != target_txn
                     LIMIT 30
                     ACCUM @@edges += e, @@vertices += t;

    PRINT @@vertices, @@edges;
}
