# ==============================================================================
# TRACE//GOA — Environment Configuration Template
# Copy this file to .env before starting the platform:
#   cp .env.example .env
# ==============================================================================

# Operation Mode: 'competition' (evaluates real IEEE-CIS benchmark) or 'dev'
TRACE_MODE=competition
APP_ENV=production

# TigerGraph Savanna / Enterprise Endpoint Configuration
# (If omitted or host contains WORKSPACE_URL_NEEDED, system operates in SIMULATOR mode)
GRAPH_BACKEND=simulator
TIGERGRAPH_HOST=https://your-savanna-instance.i.tgcloud.io:14240
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=your_tigergraph_password
TIGERGRAPH_GRAPH=FraudInvestigationGraph
TIGERGRAPH_API_TOKEN=your_savanna_api_token

# Google Gemini Reasoning LLM
# (If omitted or invalid, system operates in DETERMINISTIC_RULES fallback mode)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Persistence & Storage Paths
DATABASE_URL=sqlite:///./data/cases.db
TRACE_CASES_DB=data/cases.db
TRACE_LEDGER_DB=data/decision_ledger.db
CASE_MEMORY_PATH=data/case_memory.db

# Server Network Configuration
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0
