# ==============================================================================
# TigerGraph Agentic Fraud Investigation & Next-Best Action — Environment Config
# ==============================================================================

# TigerGraph Savanna / Enterprise Endpoint Configuration
# (If omitted, the platform automatically activates its high-performance
# in-memory graph simulator with full GSQL/traversal feature parity)
TIGERGRAPH_HOST=https://your-savanna-instance.i.tgcloud.io:14240
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=your_password
TIGERGRAPH_GRAPH=FraudInvestigationGraph
TIGERGRAPH_API_TOKEN=your_token_if_configured

# LLM Reasoning & Agent Providers (Optional / Fallback)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Relational & Vector Persistence
DATABASE_URL=sqlite:///./data/cases.db
DECISION_LEDGER_PATH=./data/decision_ledger.db
CASE_MEMORY_PATH=./data/case_memory.db

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0
